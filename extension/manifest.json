{
  "manifest_version": 3,
  "name": "DeceptiScan",
  "version": "1.0",
  "description": "Real-time deceptive link detection using machine learning. Flags phishing and misleading links before you click them.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DeceptiScan"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_start"
  }],
  "background": {
    "service_worker": "background.js"
  }
}